{
  "$jsonSchema": {
    "bsonType": "object",
    "required": [
      "orderId",
      "customer",
      "totalValue",
      "createdAt"
    ],
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "orderId": {
        "bsonType": "string",
        "minLength": 1,
        "description": "Identificador externo e único do pedido"
      },
      "customer": {
        "bsonType": "object",
        "required": [
          "customerId"
        ],
        "properties": {
          "customerId": {
            "bsonType": "string",
            "minLength": 1
          },
          "createdAt": {
            "bsonType": "date"
          }
        }
      },
      "totalValue": {
        "bsonType": [
          "decimal",
          "double",
          "int",
          "long"
        ],
        "minimum": 0.01
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updateAt": {
        "bsonType": "date"
      },
      "items": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "required": [
            "item",
            "product",
            "quantity",
            "price",
            "totalItemValue"
          ],
          "properties": {
            "orderItemId": {
              "bsonType": "string"
            },
            "item": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            },
            "product": {
              "bsonType": "string",
              "minLength": 1
            },
            "quantity": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 1
            },
            "price": {
              "bsonType": [
                "decimal",
                "double",
                "int",
                "long"
              ],
              "minimum": 0.01
            },
            "totalItemValue": {
              "bsonType": [
                "decimal",
                "double",
                "int",
                "long"
              ],
              "minimum": 0.01
            },
            "active": {
              "bsonType": [
                "bool",
                "null"
              ]
            },
            "createdAt": {
              "bsonType": "date"
            }
          }
        }
      }
    }
  }
}
